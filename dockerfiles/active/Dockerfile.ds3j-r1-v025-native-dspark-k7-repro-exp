FROM nvcr.io/nvidia/pytorch:${NGC_TAG} AS vllm-builder

ARG BUILD_JOBS
ARG VLLM_REPO_URL
ARG VLLM_REF
ARG VLLM_COMMIT
ARG VLLM_VERSION
ARG TORCH_CUDA_ARCH
ENV MAX_JOBS=${BUILD_JOBS} \
    DEBIAN_FRONTEND=noninteractive \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH} \
    PATH=/usr/lib/ccache:$PATH \
    CCACHE_DIR=/root/.ccache \
    CCACHE_MAXSIZE=50G \
    CCACHE_COMPRESS=1

RUN apt-get update && \
    apt-get install -y --no-install-recommends git ninja-build ccache && \
    rm -rf /var/lib/apt/lists/*

# Clone and pin to the EXACT vLLM release commit. Fail on any mismatch.
RUN git clone ${VLLM_REPO_URL} /workspace/vllm-src && \
    cd /workspace/vllm-src && \
    git checkout ${VLLM_COMMIT} && \
    ACTUAL=$(git rev-parse HEAD) && \
    echo "[vllm] pinned to ${ACTUAL} (${VLLM_REF})" && \
    [ "${ACTUAL}" = "${VLLM_COMMIT}" ] || \
      (echo "FATAL: vLLM commit mismatch — expected ${VLLM_COMMIT}, got ${ACTUAL}" && exit 1)

RUN pip install -q setuptools "setuptools-scm>=8" setuptools-rust ninja cmake wheel packaging jinja2 regex

# TOOLCHAIN COMPAT (not behavioral): NGC 26.05 PyTorch 2.12.0a0 removed the
# `hoist` kwarg from register_opaque_type(); v0.25.0 still passes hoist=True
# (vllm/utils/torch_utils.py:904). Required, so this must succeed.
COPY patches/common/fix_pytorch211_compat.py /tmp/fix_pytorch211_compat.py
RUN python3 /tmp/fix_pytorch211_compat.py && \
    if grep -q 'hoist=True' /workspace/vllm-src/vllm/utils/torch_utils.py; then \
        echo "FATAL: hoist=True still present after compat patch"; exit 1; \
    fi && \
    echo "[patch] pytorch compat applied (hoist kwarg removed)"

RUN --mount=type=cache,id=ccache-ds3a-v025,target=/root/.ccache \
    cd /workspace/vllm-src && \
    SETUPTOOLS_SCM_PRETEND_VERSION="${VLLM_VERSION}" \
    VLLM_TARGET_DEVICE=cuda \
    python3 setup.py bdist_wheel -d /workspace/wheels && \
    ls -lh /workspace/wheels/*.whl && \
    echo "[vllm] native-DSpark wheel built (${VLLM_REF} @ ${VLLM_COMMIT})"

