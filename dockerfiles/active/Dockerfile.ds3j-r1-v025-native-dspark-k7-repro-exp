# =========================================================================
# STAGE 1: FlashInfer builder — v0.6.15 + PR #3989 (topk=256 DSV4 dispatch)
# =========================================================================
FROM nvcr.io/nvidia/pytorch:${NGC_TAG} AS flashinfer-builder

ARG BUILD_JOBS
ARG FLASHINFER_REPO_URL
ARG FLASHINFER_REF
ARG FLASHINFER_COMMIT
ARG TORCH_CUDA_ARCH
ENV MAX_JOBS=${BUILD_JOBS} \
    CMAKE_BUILD_PARALLEL_LEVEL=${BUILD_JOBS} \
    DEBIAN_FRONTEND=noninteractive \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    UV_SYSTEM_PYTHON=1 \
    UV_BREAK_SYSTEM_PACKAGES=1 \
    UV_LINK_MODE=copy \
    TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH} \
    FLASHINFER_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH} \
    PATH=/usr/lib/ccache:$PATH \
    CCACHE_DIR=/root/.ccache \
    CCACHE_MAXSIZE=50G \
    CCACHE_COMPRESS=1 \
    CMAKE_CXX_COMPILER_LAUNCHER=ccache \
    CMAKE_CUDA_COMPILER_LAUNCHER=ccache

RUN apt-get update && \
    apt-get install -y --no-install-recommends ninja-build git ccache patch && \
    rm -rf /var/lib/apt/lists/* && \
    pip install uv && pip uninstall -y flash-attn 2>/dev/null || true

RUN --mount=type=cache,id=uv-ds3a-v025,target=/root/.cache/uv \
    uv pip install --system nvidia-nvshmem-cu13 "apache-tvm-ffi<0.2"

# Clone and pin to the EXACT FlashInfer commit. Fail on any mismatch.
RUN git clone ${FLASHINFER_REPO_URL} /workspace/flashinfer && \
    cd /workspace/flashinfer && \
    git checkout ${FLASHINFER_REF} && \
    ACTUAL=$(git rev-parse HEAD^{commit}) && \
    echo "[flashinfer] pinned to ${ACTUAL} (${FLASHINFER_REF})" && \
    [ "${ACTUAL}" = "${FLASHINFER_COMMIT}" ] || \
      (echo "FATAL: FlashInfer commit mismatch — expected ${FLASHINFER_COMMIT}, got ${ACTUAL}" && exit 1) && \
    git submodule update --init --recursive

# ---- PR #3989: SM120 DSV4 sparse-MLA topk=256 dispatch (REQUIRED, not optional) ----
# This patch is mandatory for DSpark on GB10; a silent skip would produce an image
# that looks correct and fails only at runtime. Apply strictly and verify.
ARG FLASHINFER_PR
ARG FLASHINFER_PR_HEAD
COPY patches/flashinfer/pr3989-sm120-dsv4-topk256.patch /workspace/flashinfer/
RUN cd /workspace/flashinfer && \
    git apply --verbose pr3989-sm120-dsv4-topk256.patch && \
    echo "[flashinfer] PR #${FLASHINFER_PR} applied (head ${FLASHINFER_PR_HEAD})" && \
    grep -q 'DSV4_DISPATCH(32, 256)' csrc/sparse_mla_sm120_decode_dsv4.cu || \
      (echo "FATAL: PR #3989 decode instantiation (32, 256) absent after apply" && exit 1) && \
    grep -q '(32, 256)' flashinfer/mla/_sparse_mla_sm120.py || \
      (echo "FATAL: PR #3989 python dispatch entry (32, 256) absent after apply" && exit 1) && \
    echo "[flashinfer] topk=256 DSV4 dispatch verified in patched source"

# House cubin-cache patch (optimization only; tolerated if not applicable to this ref).
COPY patches/flashinfer/flashinfer_cache.patch /workspace/flashinfer/
RUN cd /workspace/flashinfer && \
    (patch -p1 --dry-run < flashinfer_cache.patch &>/dev/null && \
     patch -p1 < flashinfer_cache.patch || echo "[flashinfer] cache patch not applicable")

WORKDIR /workspace/flashinfer
RUN --mount=type=cache,id=uv-ds3a-v025,target=/root/.cache/uv \
    --mount=type=cache,id=ccache-ds3a-v025,target=/root/.ccache \
    sed -i -e 's/license = "Apache-2.0"/license = { text = "Apache-2.0" }/' \
           -e '/license-files/d' pyproject.toml 2>/dev/null || true && \
    uv build --no-build-isolation --wheel . --out-dir=/workspace/wheels -v

RUN --mount=type=cache,id=uv-ds3a-v025,target=/root/.cache/uv \
    --mount=type=cache,id=ccache-ds3a-v025,target=/root/.ccache \
    for subpkg in flashinfer-cubin flashinfer-jit-cache; do \
        if [ -d "$subpkg" ]; then \
            echo "[flashinfer] Building $subpkg..." && \
            cd /workspace/flashinfer/$subpkg && \
            uv build --no-build-isolation --wheel . --out-dir=/workspace/wheels -v || \
            echo "[flashinfer] $subpkg build failed (optional)"; \
        fi; \
    done

