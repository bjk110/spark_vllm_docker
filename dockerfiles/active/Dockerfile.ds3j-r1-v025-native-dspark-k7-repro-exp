# ---- Runtime dependencies (source-declared, minus torch/flashinfer) ----
RUN --mount=type=cache,id=uv-ds3a-v025,target=/root/.cache/uv \
    DEPS=$(pip show vllm 2>/dev/null | grep ^Requires | sed 's/Requires: //' | tr ',' '\n' | \
      sed 's/^ *//;s/ *$//' | grep -v -E '^(torch|torchvision|torchaudio|flashinfer|$)' | \
      tr '\n' ' ') && \
    uv pip install --system $DEPS ray[default] fastsafetensors nvidia-nvshmem-cu13 uvloop && \
    uv pip install --system "compressed-tensors==0.15.0.1" --no-deps

# ---- Cutlass DSL family (COHERENT) — DS3B-R1 corrective fix ----
# The first DS3B candidate installed nvidia-cutlass-dsl with --no-deps, which left
# the family incoherent: nvidia-cutlass-dsl==4.5.2 but nvidia-cutlass-dsl-libs-base
# drifted to 4.6.0, the cu13 libs (nvidia-cutlass-dsl-libs-cu13) were never installed
# at all, and quack-kernels drifted to 0.6.1. `import cutlass` then raised
# ModuleNotFoundError and has_cutedsl() returned False. On the local
# DeepSeek-V4-Flash-DSpark checkpoint head_dim==512, and
# vllm/models/deepseek_v4/compressor.py imports sparse_attn_compress_cutedsl
# UNCONDITIONALLY on that path (that module does `import cutlass` at import time),
# so the drift is a deterministic runtime crash before any valid baseline.
#
# Fix: install the coherent family WITH its dependency closure (NOT --no-deps) and
# pin quack-kernels, then hard-verify version coherence AND the real imports.
# Verified in a disposable container from the first image: this install downgrades
# nvidia-cutlass-dsl-libs-base to 4.5.2, installs nvidia-cutlass-dsl-libs-cu13==4.5.2,
# and restores `import cutlass` and has_cutedsl()==True. (libs-core / libs-cu12 may
# remain at 4.6.0 as unused leftovers on the cu13 path — harmless, not gated.)
ARG CUTLASS_DSL_REQ
ARG QUACK_KERNELS_REQ=quack-kernels==0.5.0
RUN --mount=type=cache,id=uv-ds3a-v025,target=/root/.cache/uv \
    uv pip install --system "${CUTLASS_DSL_REQ}" "${QUACK_KERNELS_REQ}"
RUN python3 <<'PY'
import importlib, importlib.metadata as md, sys
def ver(n):
    try: return md.version(n)
    except Exception: return None
dsl   = ver("nvidia-cutlass-dsl")
base  = ver("nvidia-cutlass-dsl-libs-base")
cu13  = ver("nvidia-cutlass-dsl-libs-cu13")
quack = ver("quack-kernels")
print("[verify] nvidia-cutlass-dsl           =", dsl)
print("[verify] nvidia-cutlass-dsl-libs-base =", base)
print("[verify] nvidia-cutlass-dsl-libs-cu13 =", cu13)
print("[verify] quack-kernels                =", quack)
errs = []
if dsl   != "4.5.2": errs.append(f"nvidia-cutlass-dsl must be 4.5.2, got {dsl}")
if base  != "4.5.2": errs.append(f"nvidia-cutlass-dsl-libs-base must be 4.5.2, got {base} (first-build drift was 4.6.0)")
if cu13  != "4.5.2": errs.append(f"nvidia-cutlass-dsl-libs-cu13 must be 4.5.2, got {cu13} (first-build had it MISSING)")
if quack != "0.5.0": errs.append(f"quack-kernels must be 0.5.0, got {quack} (first-build drift was 0.6.1)")
if errs:
    print("FATAL: cutlass DSL family incoherent after install:")
    for e in errs: print("  -", e)
    sys.exit(1)
import cutlass
print("[verify] import cutlass OK ->", getattr(cutlass, "__file__", "?"))
from vllm.utils.import_utils import has_cutedsl
if has_cutedsl() is not True:
    print("FATAL: has_cutedsl() is not True after cutlass fix"); sys.exit(1)
print("[verify] has_cutedsl() == True")
m = importlib.import_module("vllm.models.deepseek_v4.nvidia.ops.sparse_attn_compress_cutedsl")
if not hasattr(m, "compress_norm_rope_store_cutedsl"):
    print("FATAL: compress_norm_rope_store_cutedsl missing"); sys.exit(1)
print("[verify] DSV4 sparse_attn_compress_cutedsl + compress_norm_rope_store_cutedsl import OK")
print("[verify] cutlass DSL family coherent (DS3B-R1 fix)")
PY

# ---- TVM-FFI + tokenspeed family: v0.25.0 declares apache-tvm-ffi==0.1.9,
# tilelang==0.1.9 AND tokenspeed-mla==0.1.2 as a COORDINATED set. The name-only
# $DEPS install resolves them to newer, mutually incoherent versions: tilelang
# drift caused a C++ abort ("TypeAttr __ffi_repr__ is already registered") at JIT
# time, and tokenspeed-mla resolves to 0.2.0 which requires apache-tvm-ffi==0.1.12,
# colliding with the required 0.1.9 sparse-path pin (DS3B-R1's fail-fast gate
# surfaced this). tokenspeed-mla==0.1.2 requires apache-tvm-ffi>=0.1.5, satisfied
# by 0.1.9. Pin all three explicitly and verify (no name-only resolution here).
RUN --mount=type=cache,id=uv-ds3a-v025,target=/root/.cache/uv \
    uv pip install --system "apache-tvm-ffi==0.1.9" "tilelang==0.1.9" "tokenspeed-mla==0.1.2" && \
    python3 -c "import importlib.metadata as md; a=md.version('apache-tvm-ffi'); t=md.version('tilelang'); k=md.version('tokenspeed-mla'); assert a=='0.1.9' and t=='0.1.9' and k=='0.1.2', f'tvm/tokenspeed family drift: apache-tvm-ffi={a} tilelang={t} tokenspeed-mla={k}'; print('[verify] apache-tvm-ffi', a, 'tilelang', t, 'tokenspeed-mla', k)" && \
    if python3 -m pip check 2>&1 | grep -iE 'apache-tvm-ffi|tilelang|tokenspeed'; then \
        echo 'FATAL: residual TVM/tokenspeed pip conflict'; exit 1; \
    fi && \
    echo '[verify] no TVM/tokenspeed pip conflict'

ARG TRANSFORMERS_VER
RUN uv pip install transformers==${TRANSFORMERS_VER} --upgrade --no-deps --system && \
    uv pip install huggingface-hub --upgrade --no-deps --system

RUN uv pip uninstall triton-kernels 2>/dev/null || true

ARG TRITON_VER=3.7.0
RUN uv pip install triton==${TRITON_VER} --upgrade --no-deps --system && \
    python3 -c "import triton; print(f'[triton] installed {triton.__version__}')"

ARG NCCL_VER=2.30.4
RUN uv pip install nvidia-nccl-cu13==${NCCL_VER} --upgrade --no-deps --system && \
    NCCL_LIB_DIR=$(find /usr/local/lib/python3.12/dist-packages/nvidia/nccl/lib /usr/local/lib/python3.12/dist-packages/nvidia_nccl_cu13/lib 2>/dev/null | grep -m1 'lib$') && \
    echo "${NCCL_LIB_DIR}" > /etc/ld.so.conf.d/zz-nvidia-nccl-cu13.conf && \
    ldconfig
ENV LD_LIBRARY_PATH=/usr/local/lib/python3.12/dist-packages/nvidia/nccl/lib:$LD_LIBRARY_PATH

# ---- Deterministic source-revision markers (prove the pinned sources) ----
RUN printf '%s\n' "702f4814fe54fabff350d43cb753ae3e47c0c276" > /opt/vllm-source-revision && \
    printf '%s\n' "8eccd0c1352165302840c0e19066bc42d36dbd7a" > /opt/flashinfer-source-revision && \
    printf '%s\n' "1459c5d337a13954e679ecc56566f194ecbbe85f" > /opt/flashinfer-pr3989-head

COPY scripts/verify_imports.py /opt/scripts/verify_imports.py
COPY scripts/verify_runtime.sh /opt/scripts/verify_runtime.sh
RUN chmod +x /opt/scripts/verify_runtime.sh

# ---- Build-time gate (no GPU, no CUDA init, no model, no weight load) ----
RUN python3 <<'PY'
import glob, importlib, os, sys
VREV = "702f4814fe54fabff350d43cb753ae3e47c0c276"
FREV = "8eccd0c1352165302840c0e19066bc42d36dbd7a"

import vllm
print("[verify] vllm_version =", vllm.__version__)
assert open("/opt/vllm-source-revision").read().strip() == VREV
assert open("/opt/flashinfer-source-revision").read().strip() == FREV

so = glob.glob(os.path.join(os.path.dirname(vllm.__file__), "_C_stable_libtorch*.so"))
assert so, "FAIL: _C_stable_libtorch*.so not present (compilation produced no extension)"
print("[verify] extension_so =", so[0], f"({os.path.getsize(so[0])/1e6:.1f} MB)")
try:
    importlib.import_module("vllm._C_stable_libtorch")
    print("[verify] extension imported")
except Exception as e:
    if "libcuda.so.1" in str(e):
        print("[verify] extension import DEFERRED (no libcuda in builder):", e)
    else:
        print("FAIL: unexpected extension import error:", e); sys.exit(1)

# Native DSpark presence (import-only; no instantiation).
from vllm.config.speculative import DSparkModelTypes
import vllm.v1.worker.gpu.spec_decode.dspark.speculator as sp
import vllm.models.deepseek_v4.nvidia.dspark as dm
assert hasattr(sp, "DSparkSpeculator"), "FAIL: DSparkSpeculator missing"
assert hasattr(dm, "DSparkDeepseekV4ForCausalLM"), "FAIL: DSparkDeepseekV4ForCausalLM missing"
print("[verify] native DSpark speculator + draft model present")

from vllm.model_executor.models.registry import ModelRegistry
assert "DeepseekV4ForCausalLM" in ModelRegistry.get_supported_archs()
print("[verify] DeepseekV4ForCausalLM registered")

# FlashInfer PR #3989 must be present in the SHIPPED csrc (runtime-JIT source).
import flashinfer
fi = os.path.dirname(flashinfer.__file__)
cu = os.path.join(fi, "data", "csrc", "sparse_mla_sm120_decode_dsv4.cu")
assert os.path.exists(cu), f"FAIL: shipped csrc missing: {cu}"
src = open(cu).read()
assert "DSV4_DISPATCH(32, 256)" in src, "FAIL: PR #3989 (32, 256) instantiation absent from shipped csrc"
py = open(os.path.join(fi, "mla", "_sparse_mla_sm120.py")).read()
assert "(32, 256)" in py, "FAIL: PR #3989 (32, 256) dispatch entry absent from installed python"
print("[verify] FlashInfer PR #3989 topk=256 present in shipped csrc + python")

# No DS2 behavioral overlay may exist. Only DS2-lineage-EXCLUSIVE paths are
# checked: v0.25.0 legitimately ships vllm/v1/spec_decode/dflash.py, so that
# path must NOT be treated as a DS2 marker. The 72261a7 lineage's DSpark
# proposer and Markov sampler lived at v1/spec_decode/{dspark,dspark_markov}.py,
# which upstream never had — those are unambiguous DS2 markers.
for stale in ("v1/spec_decode/dspark.py", "v1/spec_decode/dspark_markov.py"):
    sp_path = os.path.join(os.path.dirname(vllm.__file__), stale)
