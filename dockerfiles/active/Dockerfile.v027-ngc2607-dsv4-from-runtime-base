# syntax=docker/dockerfile:1.7
# Thin derivative recipe for the validated DeepSeek-V4 NGC 26.07/vLLM 0.27 stack.
# This base is DSV4-specific, not a model-neutral vLLM base: it already contains the validated
# dependency closure, DeepGEMM/Quack pins, and B4.3R/B4.3S sparse-MLA dispatch additions.
ARG BASE_IMAGE=ghcr.io/bjk110/vllm-spark@sha256:7a005243701c5df6f8945ea56d509f747f2c63ecff6091a0169d8109a736d09f
FROM ${BASE_IMAGE}

ARG RECIPE_REVISION=uncommitted
LABEL org.opencontainers.image.title="DeepSeek-V4 thin derivative from frozen v0.27 runtime base" \
      org.opencontainers.image.source="https://github.com/bjk110/spark_vllm_docker" \
      org.opencontainers.image.revision="${RECIPE_REVISION}" \
      org.vllm-spark.runtime-base.digest="sha256:7a005243701c5df6f8945ea56d509f747f2c63ecff6091a0169d8109a736d09f" \
      org.vllm-spark.runtime-base.scope="dsv4-specific-frozen-build-base"
