# DS3J — EXPERIMENTAL native-DSpark k=7 promotion-readiness preset (NOT production).
# Reproduces the DS3H/DS3I validated envelope on the DS3J consolidated rebuild image.
# VLLM_USE_DEEP_GEMM_E8M0=1 is MANDATORY (SM121 numerical contract, not tuning).
VLLM_IMAGE=vllm-spark:ds3j-r1-v025-native-dspark-k7-repro-exp-5cb57f7
MODEL_PATH=/home/bjk110/Documents/Models/deepseek-ai/deepseek-ai_DeepSeek-V4-Flash-DSpark
MODEL_CONTAINER_PATH=/models/DeepSeek-V4-Flash-DSpark
SERVED_MODEL_NAME=deepseek-ai/DeepSeek-V4-Flash-DSpark
CLUSTER_MODE=dual-rdma
TP_SIZE=2
HEAD_ROCE_IP=10.10.10.1
WORKER_ROCE_IP=10.10.10.2
ROCE_IF_NAME=enp1s0f0np0
IB_HCA_NAME=rocep1s0f0
DISTRIBUTED_BACKEND=mp
MASTER_PORT=29500
HOST_PORT=8000
MAX_MODEL_LEN=16384
MAX_NUM_SEQS=1
GPU_MEMORY_UTILIZATION=0.87
MAX_NUM_BATCHED_TOKENS=8192
VLLM_EXTRA_ARGS=--no-enable-prefix-caching --enforce-eager --kv-cache-memory-bytes 4294967296 --kv-cache-dtype fp8 --skip-mm-profiling --moe-backend marlin --speculative-config {"method":"dspark","num_speculative_tokens":7,"draft_sample_method":"greedy"}
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
NCCL_IB_DISABLE=0
NCCL_DEBUG=WARN
NCCL_NVLS_ENABLE=0
VLLM_USE_BREAKABLE_CUDAGRAPH=0
FLASHINFER_CUDA_ARCH_LIST=12.1
VLLM_NCCL_SO_PATH=/usr/lib/aarch64-linux-gnu/libnccl.so.2
VLLM_USE_DEEP_GEMM_E8M0=1
VLLM_MOE_USE_DEEP_GEMM=0
