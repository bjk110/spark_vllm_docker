# =============================================================================
# DeepSeek-V4-Flash-0731 — native DSpark k=7, 256K, vLLM 0.27, MAX_NUM_SEQS=4
# OPTIONAL VALIDATED PROFILE (TP2, dual DGX Spark).
#
# Status:               OPTIONAL VALIDATED PROFILE — NOT the production
#                       default. Identical to the active production preset
#                       (deepseek-v4-flash-0731-dspark-k7-256k-v027-candidate-tp2.env,
#                       promoted 2026-08-15, task B4.4C) except MAX_NUM_SEQS=4
#                       (verified: the only delta).
#
# Use only for controlled, attended, higher-concurrency validation or
# benchmarking runs. Do NOT use as an unattended default.
#
# WHY NOT DEFAULT (Residual Risk R1 — see
# docs/deepseek-v4-v027-b43s-promotion-candidate.md):
#   B4.3X's one historical spark01 abrupt host power-loss incident occurred
#   during an immediate, zero-cooldown repeat of a 128K x4 combined-pressure
#   soak run under this exact MAX_NUM_SEQS=4 condition. B4.3Y (controlled
#   reproduction attempt) and B4.3Z (four-cycle extended no-cooldown soak,
#   ~4-5x B4.3Y's exposure) both FAILED to reproduce it, and root cause
#   remains unknown. The incident has not been shown to require MS=4
#   specifically, but it has also not been ruled out as a factor -- so this
#   profile stays optional rather than default. This platform also has no
#   working hardware watchdog (R2): a host-level hang or failure of any
#   cause has no automatic recovery path and needs physical intervention.
#
# Validation coverage for THIS profile specifically:
#   MAX_NUM_SEQS=4 concurrency: B4.3U/X/Y/Z, this task's own B4.4A/B4.4B checks.
#   Global top-k JIT target (_compute_global_topk_indices_and_lens_kernel,
#     only reachable at MS>=4): validated separately in B4.4A on a disposable
#     instance; NOT wired into any automatic startup prewarm for this profile
#     -- if you use this profile, warm it manually:
#       docker exec vllm-spark-head python3 /path/to/prewarm_dsv4_v027_b43s.py \
#         --model deepseek-ai/DeepSeek-V4-Flash-0731 \
#         --tokenizer-path /models/DeepSeek-V4-Flash-0731 --concurrency-warmup
#     (or set PREWARM_CONCURRENCY_WARMUP=1 before bringing up the candidate
#     overlay's `prewarm` service, if you use it with this preset instead).
#
# Image (identical to the MS=1 production preset; see docs/images.md):
#   ghcr.io/bjk110/vllm-spark:v027-ngc2607-dsv4-0731-dspark-k7-256k-production
#   local image ID: sha256:a7f0f4b8a508c0b2510fc7e4dcb916491efa03c380c9c7b84dddd4c16ad6f38d
#
# Validation provenance: docs/deepseek-v4-v027-b43s-promotion-candidate.md,
# docs/deepseek-v4-production.md.
# =============================================================================
VLLM_IMAGE=ghcr.io/bjk110/vllm-spark:v027-ngc2607-dsv4-0731-dspark-k7-256k-production
ENTRYPOINT_FILE=./entrypoints/entrypoint.sh
MODEL_PATH=/home/bjk110/Documents/Models/deepseek-ai/deepseek-ai_DeepSeek-V4-Flash-0731
MODEL_CONTAINER_PATH=/models/DeepSeek-V4-Flash-0731
SERVED_MODEL_NAME=deepseek-ai/DeepSeek-V4-Flash-0731
CLUSTER_MODE=dual-rdma
TP_SIZE=2
HEAD_ROCE_IP=10.10.10.1
WORKER_ROCE_IP=10.10.10.2
ROCE_IF_NAME=enp1s0f0np0
IB_HCA_NAME=rocep1s0f0
DISTRIBUTED_BACKEND=mp
MASTER_PORT=29500
HOST_PORT=8000
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=4
GPU_MEMORY_UTILIZATION=0.87
MAX_NUM_BATCHED_TOKENS=8192
VLLM_EXTRA_ARGS=--no-enable-prefix-caching --kv-cache-memory-bytes 10737418240 --kv-cache-dtype fp8 --skip-mm-profiling --moe-backend marlin --speculative-config {"method":"dspark","num_speculative_tokens":7,"draft_sample_method":"greedy"} --compilation-config {"cudagraph_mode":"FULL_DECODE_ONLY","cudagraph_capture_sizes":[8],"cudagraph_num_of_warmups":2}
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
NCCL_IB_DISABLE=0
NCCL_DEBUG=WARN
NCCL_NVLS_ENABLE=0
VLLM_USE_BREAKABLE_CUDAGRAPH=0
VLLM_USE_DEEP_GEMM_E8M0=1
VLLM_MOE_USE_DEEP_GEMM=0
VLLM_MARLIN_USE_ATOMIC_ADD=0
VLLM_SKIP_INIT_MEMORY_CHECK=0
VLLM_SPARK_SKIP_FIXED_KV_PROFILE_RUN=0
VLLM_USE_RAY_V2_EXECUTOR_BACKEND=1
