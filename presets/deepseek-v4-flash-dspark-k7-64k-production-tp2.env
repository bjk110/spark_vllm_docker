# =============================================================================
# DeepSeek-V4-Flash-DSpark — native DSpark k=7, 64K production (TP2, dual DGX Spark).
#
# Status:              Active production
# Active since:        2026-07-22
# Default API:         spark01, port 8000
# Long-context cap:    MAX_MODEL_LEN=65536 (64K). Unrestricted 135168 is NOT supported.
#                      LC131 is NOT exposed; repeated LC131 is unvalidated.
# Rollback:            presets/deepseek-v4-flash-mtp1-production-tp2.env is the authoritative rollback.
#
# Image (immutable, digest-pinned runtime ref):
#   ghcr.io/bjk110/vllm-spark@sha256:aacb06de60ecdc1bcafca5209aa5f0973eb86ab786212c988847ce53575ed84c
#   image config (identity anchor): sha256:75bdf3d810558f1738927996f448056b196f83d4e09e55b23fffecfe904ead24
#   vLLM 0.25.0, native DSpark k=7 greedy, linux/arm64.
#
# Runtime contract:
#   MANDATORY VLLM_USE_DEEP_GEMM_E8M0=1 (SM121 numerical contract, not tuning).
#   graph: target FULL_DECODE_ONLY, cudagraph_capture_sizes single size 8; draft path EAGER; the
#          draft graph is NOT captured (round_up(8,7)=14>7=max_decode_tokens). The two-size
#          draft-graph capture variant is not used.
#   memory: fixed KV 10 GiB FP8; MAX_NUM_SEQS=1; prefix caching disabled; no concurrency.
#
# Operational recovery: after shutdown, large UVM allocations may NOT be fully released --
#   FULL RECOVERY MAY REQUIRE REBOOT.
#
# Validation provenance and rollback procedure: docs/deepseek-v4-production.md.
# =============================================================================
VLLM_IMAGE=ghcr.io/bjk110/vllm-spark@sha256:aacb06de60ecdc1bcafca5209aa5f0973eb86ab786212c988847ce53575ed84c
ENTRYPOINT_FILE=./entrypoints/entrypoint.sh
MODEL_PATH=/home/bjk110/Documents/Models/deepseek-ai/deepseek-ai_DeepSeek-V4-Flash-DSpark
MODEL_CONTAINER_PATH=/models/DeepSeek-V4-Flash-DSpark
SERVED_MODEL_NAME=deepseek-ai/DeepSeek-V4-Flash-DSpark
CLUSTER_MODE=dual-rdma
TP_SIZE=2
HEAD_ROCE_IP=10.10.10.1
WORKER_ROCE_IP=10.10.10.2
ROCE_IF_NAME=enp1s0f0np0
IB_HCA_NAME=rocep1s0f0
DISTRIBUTED_BACKEND=mp
MASTER_PORT=29500
HOST_PORT=8000
MAX_MODEL_LEN=65536
MAX_NUM_SEQS=1
GPU_MEMORY_UTILIZATION=0.87
MAX_NUM_BATCHED_TOKENS=8192
VLLM_EXTRA_ARGS=--no-enable-prefix-caching --kv-cache-memory-bytes 10737418240 --kv-cache-dtype fp8 --skip-mm-profiling --moe-backend marlin --speculative-config {"method":"dspark","num_speculative_tokens":7,"draft_sample_method":"greedy"} --compilation-config {"cudagraph_mode":"FULL_DECODE_ONLY","cudagraph_capture_sizes":[8],"cudagraph_num_of_warmups":2}
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
NCCL_IB_DISABLE=0
NCCL_DEBUG=WARN
NCCL_NVLS_ENABLE=0
VLLM_USE_BREAKABLE_CUDAGRAPH=0
VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=1
FLASHINFER_CUDA_ARCH_LIST=12.1
VLLM_NCCL_SO_PATH=/usr/lib/aarch64-linux-gnu/libnccl.so.2
VLLM_USE_DEEP_GEMM_E8M0=1
VLLM_MOE_USE_DEEP_GEMM=0
