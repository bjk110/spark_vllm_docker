# =============================================================================
# h1z-longout-c4-deepbatch-experimental  —  EXPERIMENTAL deep-batch c4 profile
#
#   *** EXPERIMENTAL — THROUGHPUT ONLY — NOT FOR INTERACTIVE SERVING — NOT PRODUCTION ***
#
# Purpose: 16K-context LONG-OUTPUT deep-batch / OFFLINE max throughput (tg1024/tg2048),
#          up to FOUR concurrent long-output jobs. Highest aggregate throughput at long output.
# NOT for: interactive chat, short output, low-TTFT / latency-sensitive workloads.
#          c4 TTFT ~30.6s is the highest of the three profiles.
#
# Validated behavior (H1Z-P46C/P46D, 16K, disposable H0, runs=3):
#   tg1024 ~54.0 tok/s (1.38x c1 / 1.13x c2) ; tg2048 ~67.2 tok/s (1.70x c1 / ~1.24x c2)
#   decode peak ~104 tok/s ; TTFT ~30.6s (four 16K prefills serialize at bt8192)
#   KV 107,980 tok / 2.64x ; Running=4/Waiting=0, preempt=0, no OOM ; correctness 5/5.
#
# DELTA vs production preset (deepseek-v4-h1z-b1ae-sm121-indexer-production-tp2.env):
#   VLLM_IMAGE      -> H0 tag (byte-identical to production digest @ade810fd)
#   HOST_PORT       8000 -> 8100 (non-production)
#   MAX_MODEL_LEN   135168 -> 40960 (validated experimental context ceiling)
#   MAX_NUM_SEQS    1 -> 4
#   cudagraph_capture_sizes [2] -> [8]   (MTP n=1 -> tokens/step = seqs x 2 = 8)
#   KV bytes        4 GiB -> 8 GiB (4294967296 -> 8589934592)   *** REQUIRED for c4 ***
# All other route fields identical to production (MARLIN MoE, FP8 Lightning Indexer,
# DEEPSEEK_SPARSE_SWA, DeepGEMM PDL, MTP n=1, TP=2 mp/RoCE, bt8192).
#
# HARD CONSTRAINTS (P45/P46): c4 REQUIRES 8 GiB KV — c4 with 4 GiB KV is INVALID
#   (4x16K ~66K tok > 53,990 pool -> admission fails). max_num_batched_tokens MUST stay 8192
#   (bt expansion consumes KV as prefill buffer). No bt16384/bt24576. No 32K. No KV>8 GiB.
#   No reduced max_model_len below 40960. No DSpark/B12X/Ray.
#
# RESTORE WARNING: production restore MUST use
#   --env-file presets/deepseek-v4-h1z-b1ae-sm121-indexer-production-tp2.env
#   NEVER bare .env (=base 4c41950c) ; NEVER bare docker compose.
# VALIDATION: run ONLY with a unique compose project (-p <name>) and non-production port 8100.
#   Production containers must remain STOPPED. Reboot to reclaim UMA after 8 GiB-KV weight-load.
#
# NOTE (env passthrough): VLLM_USE_DEEP_GEMM_E8M0 and VLLM_MOE_USE_DEEP_GEMM must be passed
# through to BOTH head and worker containers by docker-compose.
# NOTE (JIT cache): before cold startup, wipe the allowlisted compile caches
# (cache/unholy-hf/{deepgemm-cache-rank*,triton-cache-rank*,torchinductor-rank*,vllm-cache}
# + .cache/vllm + cache/triton + cache/unholy-jit). Preserve model/tokenizer/FlashInfer AOT.
# =============================================================================

VLLM_IMAGE=vllm-spark:h1z-p38c-overlay-rebuild-h0-20260706T125127
ENTRYPOINT_FILE=./entrypoints/entrypoint.sh
MODEL_PATH=/home/bjk110/Documents/Models/deepseek-ai/DeepSeek-V4-Flash
MODEL_CONTAINER_PATH=/models/DeepSeek-V4-Flash
SERVED_MODEL_NAME=deepseek-ai/DeepSeek-V4-Flash
CLUSTER_MODE=dual-rdma
TP_SIZE=2
HEAD_ROCE_IP=10.10.10.1
WORKER_ROCE_IP=10.10.10.2
ROCE_IF_NAME=enp1s0f0np0
IB_HCA_NAME=rocep1s0f0
RAY_PORT=6379
DISTRIBUTED_BACKEND=mp
MASTER_PORT=29500
HOST_PORT=8100
MAX_MODEL_LEN=40960
MAX_NUM_SEQS=4
GPU_MEMORY_UTILIZATION=0.87
MAX_NUM_BATCHED_TOKENS=8192
VLLM_EXTRA_ARGS=--no-enable-prefix-caching --kv-cache-memory-bytes 8589934592 --kv-cache-dtype fp8 --skip-mm-profiling --moe-backend marlin --speculative-config {"method":"deepseek_mtp","num_speculative_tokens":1} --compilation-config {"cudagraph_mode":"FULL_DECODE_ONLY","cudagraph_capture_sizes":[8],"cudagraph_num_of_warmups":2}
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
NCCL_IB_DISABLE=0
NCCL_DEBUG=WARN
NCCL_NVLS_ENABLE=0
NCCL_NET=
VLLM_USE_BREAKABLE_CUDAGRAPH=0
VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=1
FLASHINFER_CUDA_ARCH_LIST=12.1
VLLM_USE_RAY_V2_EXECUTOR_BACKEND=0
VLLM_NCCL_SO_PATH=/usr/lib/aarch64-linux-gnu/libnccl.so.2
VLLM_USE_DEEP_GEMM_E8M0=0
VLLM_MOE_USE_DEEP_GEMM=0
