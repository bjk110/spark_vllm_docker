# =============================================================================
# Solar-Open2-250B Nota NVFP4 — first dual-node smoke test (TP2, dual DGX Spark).
#
# Status:      EXPERIMENTAL / DISPOSABLE — do not promote, do not route via OWUI/Traefik.
# Created:     2026-07-24 (first runtime validation of solar_open2 on GB10)
# Model:       nota-ai/Solar-Open2-250B-Nota-NVFP4
#              pinned HF revision de88f6226788077e2d340204fd79d37720c9eda0
#              compressed-tensors NVFP4 (W4A4, group_size 16)
# Image:       vllm-spark:solar-open2-nvfp4-v022d568-vllm0221-upstage00907fc-exp
#              (local experimental; base ghcr.io/bjk110/vllm-spark:v022-d568-ngc2605-tx5102-vllm022,
#               vLLM 0.22.1 + UpstageAI/vllm@00907fc9b982 solar-open2 overlay, pure-Python)
# Serving:     Nota AI dual-DGX-Spark baseline settings (TP=2, ray, eager, 4K,
#              gpu-mem-util 0.80, max-num-seqs 8, batched 2048, moe flashinfer_b12x).
# Note:        entrypoint.sh always adds --trust-remote-code and --enable-prefix-caching;
#              custom model .py files reviewed (no network/exec); vLLM native solar_open2
#              registry takes precedence, so trust-remote-code is effectively inert.
# =============================================================================
VLLM_IMAGE=vllm-spark:solar-open2-nvfp4-v022d568-vllm0221-upstage00907fc-ecfix-exp
ENTRYPOINT_FILE=./entrypoints/entrypoint.sh
MODEL_PATH=/home/bjk110/Documents/Models/upstage/nota-ai_Solar-Open2-250B-Nota-NVFP4
MODEL_CONTAINER_PATH=/models/Solar-Open2-250B-Nota-NVFP4
SERVED_MODEL_NAME=solar-open2-250b
CLUSTER_MODE=dual-rdma
TP_SIZE=2
HEAD_ROCE_IP=10.10.10.1
WORKER_ROCE_IP=10.10.10.2
ROCE_IF_NAME=enp1s0f0np0
IB_HCA_NAME=rocep1s0f0
DISTRIBUTED_BACKEND=ray
RAY_PORT=6379
HOST_PORT=8000
MAX_MODEL_LEN=4096
MAX_NUM_SEQS=8
GPU_MEMORY_UTILIZATION=0.80
MAX_NUM_BATCHED_TOKENS=2048
VLLM_EXTRA_ARGS=--enforce-eager --kv-cache-memory-bytes 4294967296 --moe-backend flashinfer_b12x --default-chat-template-kwargs {"think_render_option":"preserved"} --reasoning-parser solar_open2 --tool-call-parser solar_open2 --enable-auto-tool-choice --logits-processors vllm.v1.sample.logits_processor.solar_open2:SolarOpen2TemplateLogitsProcessor
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
NCCL_IB_DISABLE=0
NCCL_DEBUG=WARN
NCCL_NVLS_ENABLE=0
VLLM_USE_BREAKABLE_CUDAGRAPH=0
FLASHINFER_CUDA_ARCH_LIST=12.1
VLLM_NCCL_SO_PATH=/usr/lib/aarch64-linux-gnu/libnccl.so.2

# --- Attempt 2 mitigation (2026-07-24) -----------------------------------
# Attempt 1 failed: spark02 raylet was marked dead (missed heartbeats) while
# TP ranks were loading the 142.78 GiB NVFP4 checkpoint under UMA pressure.
# Cap the Ray object store at 4 GiB (default = 30% of RAM ~ 36 GiB) so the
# plasma store cannot compete with weight loading for unified memory.
# Health-check tolerance is raised separately via the disposable override
# compose file docker-compose.solar-open2-hc-exp.yml.
RAY_OBJECT_STORE_MEMORY_BYTES=4294967296

# --- Attempt 3 mitigation (2026-07-24) -----------------------------------
# Image switched to the -ecfix-exp child image, which adds the per-module
# torch.cuda.empty_cache() hook for CompressedTensorsW4A4Nvfp4MoEMethod
# (port of patch_step3p7_modelopt_cache_release.py) and bakes
# VLLM_SPARK_EMPTY_CACHE_AFTER_CT_NVFP4_MOE=1. Root cause of attempts 1-2:
# cumulative CUDA reserved-pool growth during NVFP4 MoE post-processing
# -> NVRM NV_ERR_NO_MEMORY -> spark02 host stall (kernel log evidence in
# the first-run evidence directory).

# DI-arc disposable derived preset (2026-07-26): validated 0.22.1 eager-4k
# preset + --kv-cache-memory-bytes 4294967296 ONLY, to match the r4 KV4G
# geometry for the decode-isolation A/B. EXPERIMENTAL - do not promote.
